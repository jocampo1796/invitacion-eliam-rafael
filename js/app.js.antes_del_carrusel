/* Invitación Eliam Rafael · JavaScript sin dependencias externas. */
(() => {
  'use strict';

  const initialConfig = window.INVITATION_CONFIG || {};
  const config = {
    date: '', time: '', place: '', address: '', mapsUrl: '', whatsapp: '',
    wishesEmail: 'eliam.rafael@outlook.com',
    musicSrc: '', musicData: '', musicName: '',
    months: [],
    ...initialConfig,
  };
  const $ = (selector) => document.querySelector(selector);
  const $$ = (selector) => document.querySelectorAll(selector);
  let toastTimer;
  let importingMusic = false;

  const audio = $('#partyAudio');
  const musicButton = $('#musicBtn');
  const musicLabel = $('#musicBtnText');

  function toast(message) {
    const node = $('#toast');
    node.textContent = message;
    node.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => node.classList.remove('show'), 4100);
  }

  // Audio: nunca se reproduce automáticamente porque los navegadores
  // normalmente requieren una interacción de la persona invitada.
  function currentMusic() {
    return config.musicData || config.musicSrc || '';
  }
  function updateMusicButton() {
    const playing = !!currentMusic() && !audio.paused;
    musicButton.classList.toggle('playing', playing);
    musicButton.setAttribute('aria-pressed', String(playing));
    musicLabel.textContent = playing ? 'Pausar' : currentMusic() ? 'Escuchar' : 'Música';
    document.querySelector('#musicIcon').textContent =  playing ? '❚❚' : '▶';
    musicButton.setAttribute('aria-label', playing ? 'Pausar la música' : currentMusic() ? 'Reproducir música' : 'Configurar música');
  }
  function updateMusicState() {
    $('#musicState').textContent = currentMusic()
      ? `✓ Canción seleccionada: ${config.musicName || config.musicSrc || 'audio personalizado'}`
      : 'Todavía no se ha seleccionado una canción.';
    $('#removeMusicBtn').hidden = !currentMusic();
  }
  function syncMusic() {
    audio.pause();
    audio.removeAttribute('src');
    const music = currentMusic();
    if (music) {
      audio.src = music;
      audio.load();
    }
    updateMusicButton();
    updateMusicState();
  }
  audio.volume = 0.48;
  ['play', 'pause', 'ended'].forEach((eventName) => audio.addEventListener(eventName, updateMusicButton));
  musicButton.addEventListener('click', async () => {
    if (!currentMusic()) {
  toast('La música todavía no está configurada.');
  return;
    }
    if (!audio.paused) {
      audio.pause();
      return;
    }
    try {
      await audio.play();
    } catch (_) {
      toast('No se pudo reproducir la música. Comprueba la ruta o el archivo de audio.');
    }
  });

  $('#musicInput').addEventListener('change', (event) => {
    const file = event.target.files?.[0];
    if (!file) return;
    const extension = file.name.split('.').pop().toLowerCase();
    if (!['mp3', 'm4a', 'ogg', 'wav'].includes(extension)) {
      toast('Elige un archivo MP3, M4A, OGG o WAV.');
      event.target.value = '';
      return;
    }
    if (file.size > 12 * 1024 * 1024) {
      toast('El archivo debe pesar menos de 12 MB. Prueba un MP3 comprimido.');
      event.target.value = '';
      return;
    }
    importingMusic = true;
    $('#downloadBtn').disabled = true;
    $('#musicState').textContent = 'Preparando la canción…';
    const reader = new FileReader();
    reader.onload = () => {
      config.musicData = String(reader.result || '');
      config.musicSrc = '';
      config.musicName = file.name;
      importingMusic = false;
      $('#downloadBtn').disabled = false;
      syncMusic();
      toast('Canción agregada. Pulsa «Escuchar» para probarla.');
    };
    reader.onerror = () => {
      importingMusic = false;
      $('#downloadBtn').disabled = false;
      updateMusicState();
      toast('No se pudo cargar el archivo.');
    };
    reader.readAsDataURL(file);
  });
  $('#removeMusicBtn').addEventListener('click', () => {
    config.musicData = '';
    config.musicSrc = '';
    config.musicName = '';
    $('#musicInput').value = '';
    syncMusic();
    toast('Música eliminada de esta configuración.');
  });

  function displayDate(value) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return 'Por confirmar';
    const date = new Date(`${value}T12:00:00Z`);
    if (Number.isNaN(date.getTime())) return 'Por confirmar';
    return new Intl.DateTimeFormat('es-MX', {
      day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
    }).format(date);
  }
  function displayTime(value) {
    if (!/^\d{2}:\d{2}$/.test(value)) return 'Por confirmar';
    const [hours, minutes] = value.split(':').map(Number);
    return new Intl.DateTimeFormat('es-MX', {
      hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'UTC',
    }).format(new Date(Date.UTC(2026, 0, 1, hours, minutes)));
  }
  function updateCountdown() {
    const countdown = $('#countdown');
    const pending = $('#countdownPending');
    if (!config.date) {
      countdown.hidden = true;
      pending.hidden = false;
      pending.textContent = 'La cuenta regresiva comenzará cuando confirmemos la fecha.';
      return;
    }
    // Coatzacoalcos, Veracruz: UTC−06:00. No depende del huso horario del invitado.
    const target = new Date(`${config.date}T${config.time || '00:00'}:00-06:00`);
    if (Number.isNaN(target.getTime())) {
      countdown.hidden = true;
      pending.hidden = false;
      pending.textContent = 'Confirma la fecha y hora para activar la cuenta regresiva.';
      return;
    }
    const difference = target.getTime() - Date.now();
    if (difference <= 0) {
      countdown.hidden = true;
      pending.hidden = false;
      pending.textContent = '¡Llegó el gran día de Eliam Rafael!';
      return;
    }
    pending.hidden = true;
    countdown.hidden = false;
    const days = Math.floor(difference / 86_400_000);
    const hours = Math.floor(difference % 86_400_000 / 3_600_000);
    const minutes = Math.floor(difference % 3_600_000 / 60_000);
    const seconds = Math.floor(difference % 60_000 / 1_000);
    [['#d', days], ['#h', hours], ['#m', minutes], ['#s', seconds]].forEach(([selector, value]) => {
      $(selector).textContent = String(value).padStart(2, '0');
    });
  }

  function renderMonths() {
    const gallery = $('#monthsGrid');
    gallery.replaceChildren();
    const configuredMonths = Array.isArray(config.months) ? config.months : [];
    for (let index = 0; index < 12; index += 1) {
      const month = configuredMonths[index] || {};
      const card = document.createElement('article');
      card.className = 'month-card';
      const photo = (month.photo || '').trim();
      if (photo) {
        const image = document.createElement('img');
        image.className = 'month-photo';
        image.loading = 'lazy';
        image.src = photo;
        image.alt = `Eliam Rafael en el mes ${index + 1}`;
        image.addEventListener('error', () => {
          card.classList.remove('with-photo');
          image.remove();
        });
        card.classList.add('with-photo');
        card.appendChild(image);
      }
      const badge = document.createElement('div');
      badge.className = 'month-badge';
      badge.textContent = String(index + 1);
      const title = document.createElement('div');
      title.className = 'month-title';
      title.textContent = month.title || `Mes ${index + 1}`;
      const caption = document.createElement('p');
      caption.textContent = month.caption || 'Un mes de recuerdos inolvidables.';
      card.append(badge, title, caption);
      gallery.append(card);
    }
  }

  function render() {
    $('#displayDate').textContent = displayDate(config.date);
    $('#displayTime').textContent = displayTime(config.time);
    $('#displayPlace').textContent = config.place || 'Por confirmar';
    $('#displayAddress').textContent = config.address || '';
    const link = $('#mapsLink');
    const fallback = config.address
      ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(config.address)}`
      : '';
    const url = config.mapsUrl || fallback;
    if (url && /^https:\/\//i.test(url)) {
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.setAttribute('aria-disabled', 'false');
    } else {
      link.href = '#detalles';
      link.removeAttribute('target');
      link.setAttribute('aria-disabled', 'true');
    }
    $('#waHint').textContent = config.whatsapp
      ? 'La confirmación se preparará para enviar por WhatsApp a la familia.'
      : 'Aún no se ha configurado el número. Podrás elegir un chat de WhatsApp.';
    updateCountdown();
    renderMonths();
  }

  function openModal(id) {
    $(`#${id}`).classList.add('open');
    document.body.style.overflow = 'hidden';
    $(`#${id} input`)?.focus();
  }
  function closeModal(id) {
    $(`#${id}`).classList.remove('open');
    document.body.style.overflow = '';
  }
  $$('[data-close]').forEach((button) => button.addEventListener('click', () => closeModal(button.dataset.close)));
  $$('.overlay').forEach((overlay) => overlay.addEventListener('click', (event) => {
    if (event.target === overlay) closeModal(overlay.id);
  }));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') $$('.overlay.open').forEach((overlay) => closeModal(overlay.id));
  });

  const fields = [
    ['dateInput', 'date'], ['timeInput', 'time'], ['placeInput', 'place'],
    ['addressInput', 'address'], ['mapsInput', 'mapsUrl'], ['phoneInput', 'whatsapp'],
  ];
  function captureFields() {
    fields.forEach(([id, key]) => { config[key] = $(`#${id}`).value.trim(); });
    config.whatsapp = config.whatsapp.replace(/\D/g, '');
  }
  $('#editBtn')?.addEventListener('click', () => {
    fields.forEach(([id, key]) => { $(`#${id}`).value = config[key] || ''; });
    updateMusicState();
    openModal('editModal');
  });
  $('#editForm').addEventListener('submit', (event) => {
    event.preventDefault();
    captureFields();
    render();
    closeModal('editModal');
    toast('Vista previa actualizada. Descarga config.js para guardar los cambios en VS Code.');
  });
  $('#downloadBtn').addEventListener('click', () => {
    if (importingMusic) return;
    captureFields();
    render();
    const json = JSON.stringify(config, null, 2)
      .replace(/</g, '\\u003c')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
    const output = `// Configuración exportada para la invitación de Eliam Rafael.\nwindow.INVITATION_CONFIG = ${json};\n`;
    const blobUrl = URL.createObjectURL(new Blob([output], { type: 'text/javascript;charset=utf-8' }));
    const anchor = document.createElement('a');
    anchor.href = blobUrl;
    anchor.download = 'config.js';
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    setTimeout(() => URL.revokeObjectURL(blobUrl), 5000);
    toast('Descargaste config.js. Reemplaza js/config.js en tu proyecto y guarda.');
  });

  $('#rsvpBtn').addEventListener('click', () => openModal('rsvpModal'));
  $('#rsvpForm').addEventListener('submit', (event) => {
    event.preventDefault();
    const name = $('#guestName').value.trim();
    const guests = $('#guestCount').value;
    if (!name) return;
    const message = `¡Hola! Confirmo mi asistencia al primer cumpleaños de Eliam Rafael.\nNombre: ${name}\nPersonas: ${guests}\n¡Nos vemos!`;
    const base = config.whatsapp ? `https://wa.me/${config.whatsapp}` : 'https://api.whatsapp.com/send';
    const target = `${base}?text=${encodeURIComponent(message)}`;
    window.open(target, '_blank', 'noopener,noreferrer');
    closeModal('rsvpModal');
  });
  $('#mapsLink').addEventListener('click', (event) => {
    if (event.currentTarget.getAttribute('aria-disabled') === 'true') event.preventDefault();
  });

  const wishForm = $('#wishForm');
  function wishData() {
    const name = $('#wishName').value.trim();
    const relation = $('#wishRelation').value.trim();
    const message = $('#wishMessage').value.trim();
    if (!name || !message) return null;
    const subject = 'Buenos deseos para Eliam Rafael';
    const body = [
      'Hola Eliam Rafael,', '', 'Te comparto este mensaje con mucho cariño:', '',
      message, '', 'Con cariño,', name, relation ? `(${relation})` : '',
    ].join('\n');
    return { subject, body };
  }
  wishForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const wish = wishData();
    if (!wish) {
      toast('Escribe tu nombre y tu mensaje para Eliam.');
      return;
    }
    const address = config.wishesEmail || 'eliam.rafael@outlook.com';
    window.location.href = `mailto:${encodeURIComponent(address)}?subject=${encodeURIComponent(wish.subject)}&body=${encodeURIComponent(wish.body)}`;
    toast('Tu correo está preparado. Revisa el mensaje y pulsa «Enviar» en tu aplicación de correo.');
  });
  $('#copyWishBtn').addEventListener('click', async () => {
    const wish = wishData();
    if (!wish) {
      toast('Escribe tu nombre y tu deseo para copiarlo.');
      return;
    }
    const text = `${wish.subject}\n\n${wish.body}`;
    try {
      await navigator.clipboard.writeText(text);
      toast('Mensaje copiado al portapapeles.');
    } catch (_) {
      const field = document.createElement('textarea');
      field.value = text;
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      const copied = document.execCommand('copy');
      field.remove();
      toast(copied ? 'Mensaje copiado.' : 'No se pudo copiar automáticamente. Puedes seleccionar tu mensaje.');
    }
  });

  // La cuenta regresiva se actualiza cada segundo mientras la página está abierta.
  syncMusic();
  render();
  setInterval(updateCountdown, 1000);
})();
